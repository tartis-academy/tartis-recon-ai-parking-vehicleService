# Variables de las herramientas COMPARTIDAS (pgAdmin, SonarQube).
# Copia a .env antes de levantar:
#   cp .env.example .env
#
# OJO: este .env solo lo lee el compose de la RAIZ. El Postgres de
# vehicle-service tiene el suyo en backend/vehicle-service/.env

# --- pgAdmin ---
PGADMIN_EMAIL=admin@tartis.local
PGADMIN_PASSWORD=change.me
PGADMIN_PORT=5050

# --- SonarQube ---
SONARQUBE_PORT=9000
