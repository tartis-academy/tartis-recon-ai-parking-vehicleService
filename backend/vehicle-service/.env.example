# Variables del Postgres dedicado de vehicle-service.
# Copia a .env antes de levantar:
#   cp .env.example .env && docker compose up -d
#
# Estas mismas credenciales van en application.properties
# (spring.datasource.*) para que el servicio se conecte aqui.

VEHICLE_DB_NAME=vehicle_db
VEHICLE_DB_USER=vehicle_user
VEHICLE_DB_PASSWORD=change.me

# Puerto EN EL HOST. Dentro de la red parking-shared el puerto sigue siendo
# el 5432. Cada servicio debe usar uno distinto aqui: spot 5434, tariff 5435...
VEHICLE_DB_PORT=5433
